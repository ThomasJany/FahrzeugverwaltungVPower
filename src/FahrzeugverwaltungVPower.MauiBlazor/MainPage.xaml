<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:FahrzeugverwaltungVPower.UI;assembly=FahrzeugverwaltungVPower.UI"
             xmlns:components="clr-namespace:FahrzeugverwaltungVPower.MauiBlazor.Components"
             x:Class="FahrzeugverwaltungVPower.MauiBlazor.MainPage"
             SafeAreaEdges="None">

    <!-- Edge-to-Edge: MAUI lässt keinen Rand für Systemleisten, das übernimmt das CSS der Seite (wwwroot/app.css). -->
    <!-- Alle Seiten kommen aus der Razor-Klassenbibliothek (FahrzeugverwaltungVPower.UI). -->
    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type ui:Routes}" />
            <RootComponent Selector="#safe-area-bridge" ComponentType="{x:Type components:SafeAreaBridge}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
