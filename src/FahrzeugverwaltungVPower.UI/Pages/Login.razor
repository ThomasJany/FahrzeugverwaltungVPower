@page "/login"
@attribute [AllowAnonymous]
@inject AuthService Auth
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Anmelden</PageTitle>

<MudGrid Justify="Justify.Center">
    <MudItem xs="12" sm="8" md="5" lg="4">
        <MudPaper Class="pa-6">
            <MudText Typo="Typo.h5" GutterBottom="true">Anmelden</MudText>

            <EditForm Model="_model" OnValidSubmit="SubmitAsync">
                <DataAnnotationsValidator />

                <MudTextField @bind-Value="_model.Email" For="() => _model.Email" Label="E-Mail"
                              InputType="InputType.Email" Variant="Variant.Outlined" Margin="Margin.Dense"
                              autocomplete="username" Class="mb-3" />

                <MudTextField @bind-Value="_model.Password" For="() => _model.Password" Label="Passwort"
                              InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense"
                              autocomplete="current-password" />

                <ErrorList Errors="_errors" />

                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                           FullWidth="true" Disabled="_busy" Class="mt-3">
                    @(_busy ? "Wird angemeldet ..." : "Anmelden")
                </MudButton>
            </EditForm>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private readonly LoginModel _model = new();
    private IReadOnlyList<ApiError> _errors = [];
    private bool _busy;

    /// <summary>Seite, zu der nach der Anmeldung zurückgekehrt wird.</summary>
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthStateProvider.GetAuthenticationStateAsync();

        if (state.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        _errors = [];

        ApiResult result = await Auth.LoginAsync(_model.Email.Trim(), _model.Password);

        _busy = false;

        if (result.Success)
        {
            Navigation.NavigateTo(SafeReturnUrl());
        }
        else
        {
            _errors = result.Errors;
        }
    }

    // Nur Adressen innerhalb dieser Anwendung zulassen, sonst könnte ein Link zu einer fremden Seite weiterleiten.
    private string SafeReturnUrl() =>
        ReturnUrl is { Length: > 0 } url && url.StartsWith('/') && !url.StartsWith("//") && !url.StartsWith("/\\") ? url : "/";

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Die E-Mail-Adresse ist erforderlich.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Das Passwort ist erforderlich.")]
        public string Password { get; set; } = string.Empty;
    }
}
