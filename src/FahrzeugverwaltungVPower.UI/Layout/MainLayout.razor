@inherits LayoutComponentBase
@inject AuthService Auth
@inject NavigationManager Navigation

<MudThemeProvider @ref="_themeProvider" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <AuthorizeView>
            <Authorized>
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="() => _drawerOpen = !_drawerOpen" />
            </Authorized>
        </AuthorizeView>

        <MudText Typo="Typo.h6">Fahrzeugverwaltung</MudText>
        <MudSpacer />

        <MudTooltip Text="@(_isDarkMode ? "Heller Modus" : "Dunkler Modus")">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit" OnClick="() => _isDarkMode = !_isDarkMode" />
        </MudTooltip>

        <AuthorizeView>
            <Authorized>
                <MudTooltip Text="@RoleText(context.User)">
                    <MudText Class="mr-4">@context.User.Identity?.Name</MudText>
                </MudTooltip>
                <MudButton Variant="Variant.Outlined" Color="Color.Inherit" OnClick="LogoutAsync">Abmelden</MudButton>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <AuthorizeView>
        <Authorized>
            <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Persistent" Elevation="1" ClipMode="DrawerClipMode.Always">
                <NavMenu />
            </MudDrawer>
        </Authorized>
    </AuthorizeView>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Ein unerwarteter Fehler ist aufgetreten.
    <a href="." class="reload">Neu laden</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private MudThemeProvider _themeProvider = null!;
    private bool _drawerOpen = true;
    private bool _isDarkMode;

    // Beim ersten Anzeigen gilt die Einstellung des Betriebssystems bzw. Browsers, danach der Schalter in der Kopfzeile.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isDarkMode = await _themeProvider.GetSystemDarkModeAsync();
            StateHasChanged();
        }
    }

    private static string RoleText(ClaimsPrincipal user) =>
        string.Join(", ", user.FindAll(ClaimTypes.Role).Select(c => c.Value));

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Navigation.NavigateTo("login");
    }
}
