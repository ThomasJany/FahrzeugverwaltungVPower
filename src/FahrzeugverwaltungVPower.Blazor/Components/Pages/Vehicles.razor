@page "/vehicles"
@using FahrzeugverwaltungVPower.Core.Entities
@rendermode InteractiveServer

<PageTitle>Vehicles</PageTitle>

<h1>Vehicles</h1>

<EditForm OnSubmit="CreateVehicle" autocorrect="off" Model="Model" FormName="vehicle-form">
    <label for="holder">Halter</label>
    <InputText type="text" id="holder" placeholder="Halter" @bind-Value="Model.Holder" class="form-control mb-3" />

    <label for="model">Modell</label>
    <InputText type="text" id="model" placeholder="Modell" @bind-Value="Model.Model" class="form-control mb-3" />

    <label for="vin">VIN</label>
    <InputNumber type="number" id="vin" placeholder="VIN" @bind-Value="Model.VIN" class="form-control mb-3" />

    <label for="licensePlate">Kennzeichen</label>
    <InputText type="text" id="licensePlate" placeholder="Kennzeichen" @bind-Value="Model.LicensePlate" class="form-control mb-3" />

    <label for="inspectionValidUntil">TÜV gültig bis</label>
    <InputDate id="inspectionValidUntil" placeholder="TÜV gültig bis" @bind-Value="Model.InspectionValidUntil" class="form-control mb-3" />

    <label for="firstRegistrationDate">Erstzulassung</label>
    <InputDate id="firstRegistrationDate" placeholder="Erstzulassung" @bind-Value="Model.FirstRegistrationDate" class="form-control mb-3" />

    <label for="manufacturer">Hersteller</label>
    <InputText type="text" id="manufacturer" placeholder="Hersteller" @bind-Value="Model.Manufacturer" class="form-control mb-3" />

    <label for="hsn">HSN</label>
    <InputNumber type="number" id="hsn" placeholder="HSN" @bind-Value="Model.HSN" class="form-control mb-3" />

    <label for="tsn">TSN</label>
    <InputNumber type="number" id="tsn" placeholder="TSN" @bind-Value="Model.TSN" class="form-control mb-3" />

    <button type="submit">Create Vehicle</button>
</EditForm>

@code {
    [SupplyParameterFromForm]
    private Vehicle Model { get; set; } = null!;

    private void CreateVehicle()
    {
        var vehicle = Model;
        // Send vehicle data
    }   
}
