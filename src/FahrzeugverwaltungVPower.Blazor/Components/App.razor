<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["_content/FahrzeugverwaltungVPower.UI/app.css"]" />
    <link rel="stylesheet" href="@Assets["FahrzeugverwaltungVPower.Blazor.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServerWithoutPrerender" />
</head>

<body>
    <Routes @rendermode="InteractiveServerWithoutPrerender" />
    <ReconnectModal />
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // Die gesamte Oberfläche läuft interaktiv auf dem Server und ohne Vorab-Rendern:
    // Der Token-Speicher liegt im Browser (sessionStorage) und ist beim Vorab-Rendern noch nicht erreichbar.
    private static readonly IComponentRenderMode InteractiveServerWithoutPrerender = new InteractiveServerRenderMode(prerender: false);
}
